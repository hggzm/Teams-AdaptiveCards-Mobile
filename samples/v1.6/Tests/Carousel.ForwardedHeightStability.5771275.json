{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "TextBlock",
      "text": "Synthetic forwarded-carousel height probe",
      "wrap": true
    },
    {
      "type": "Carousel",
      "pages": [
        {
          "type": "CarouselPage",
          "id": "pageOne",
          "items": [
            {
              "type": "TextBlock",
              "text": "A11YMAS 5771275 short page marker",
              "wrap": true
            },
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "altText": "Synthetic local image",
              "size": "medium"
            },
            {
              "type": "TextBlock",
              "text": "Short page with a deterministic local image.",
              "wrap": true
            }
          ]
        },
        {
          "type": "CarouselPage",
          "id": "pageTwo",
          "items": [
            {
              "type": "TextBlock",
              "text": "A11YMAS 5771275 tall page marker",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "Synthetic long content exercises a taller carousel page and stable text wrapping at the Visualizer width.",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "This second block adds more deterministic page content without a network image or customer payload.",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "A third wrapped block makes the page height measurably different from the short page.",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "A11YMAS 5771275 tall page end marker",
              "wrap": true
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "A11YMAS 5771275 footer marker",
      "wrap": true
    }
  ]
}
